{
  "task_description": "{'component_name': 'Main Container for NeuroQuest: The Productivity RPG', 'description': "Primary container for NeuroQuest: The Productivity RPG implementation: NeuroQuest is a gamified productivity RPG web app where users set a major life goal (e.g., 'Crack GATE CS 2025'), and the app breaks it into smart quests, tracks focus, rewards XP, and features 'Boss Battles' as deadlines. The app uses a fantasy-futuristic theme, is fully responsive, modular, and API-ready. Built with React + Vite, TailwindCSS, Firebase, OpenAI GPT, Google Calendar API, and Lottie animations. Features include RPG dashboard, AI quest breakdown, focus engine, boss battles, inventory, calendar sync, and settings.", 'framework': 'vite', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "Firebase Auth",\n      "description": "User authentication via Google and Email/Password using Firebase Auth. Secure login with dark overlay and glowing card UI.",\n      "isEnabled": true\n    },\n    {\n      "name": "AI Quest Breakdown",\n      "description": "OpenAI GPT API generates a smart, multi-level quest roadmap from the user\'s main goal. Tasks are grouped into main questline, side quests, and microtasks.",\n      "isEnabled": true\n    },\n    {\n      "name": "RPG Dashboard",\n      "description": "Main hub with XP/HP bars, avatar, level, streaks, and zones: Focus Forest, Deadline Dungeon, Daily Hills. Floating Quest Orb for quick access.",\n      "isEnabled": true\n    },\n    {\n      "name": "Quest Log",\n      "description": "Displays AI-generated and manual tasks, grouped by quest type. Tasks can be checked off, added, or reorganized. Optional AI rewrite for manual tasks.",\n      "isEnabled": true\n    },\n    {\n      "name": "Boss Battles",\n      "description": "Triggered by calendar deadlines or milestones. Features countdown, dramatic UI, Lottie victory animation, and XP/HP outcomes.",\n      "isEnabled": true\n    },\n    {\n      "name": "Focus Engine",\n      "description": "Simulates focus tracking using setInterval and randomization. Awards XP for active focus, tracks streaks, and detects calm mode.",\n      "isEnabled": true\n    },\n    {\n      "name": "Inventory & Rewards",\n      "description": "Soul Tokens and NFT-style cosmetic rewards. Equip items to avatar and view level-unlock rewards.",\n      "isEnabled": true\n    },\n    {\n      "name": "Calendar Sync",\n      "description": "Integrates Google Calendar API to show, sync, and convert events to Boss Battles. Syncs deadlines between app and calendar.",\n      "isEnabled": true\n    },\n    {\n      "name": "Settings",\n      "description": "Toggle dark/light mode, animations, change goal, start new quest, and logout.",\n      "isEnabled": true\n    },\n    {\n      "name": "Lottie Animations",\n      "description": "Celebration and victory animations using Lottie for enhanced feedback and motivation.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "Vite"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#7c3aed",\n    "secondary": "#0f172a",\n    "accent": "#4ade80"\n  },\n  "theme": "auto",\n  "layoutDescription": "The UI features a fantasy-futuristic RPG theme with a dark midnight navy background, neon-violet accents, and glowing elements. The main dashboard (The Kingdom) displays XP/HP bars, avatar, and quick stats at the top. Zones (Focus Forest, Deadline Dungeon, Daily Hills) are shown as interactive cards or sections. A floating Quest Orb provides quick quest access. All pages are fully responsive, with modular components (XPBar, HPBar, QuestCard, Avatar, FocusMeter, FloatingOrb, LottieAnim). Animations and neon-glow effects enhance interactivity. Navigation is handled by React Router, and the layout is optimized for both desktop and mobile."\n}'}",
